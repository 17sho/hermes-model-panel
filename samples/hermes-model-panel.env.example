PORT=3010
HOST=127.0.0.1
HERMES_CONFIG=/root/.hermes/config.yaml
HERMES_HOME=/root/.hermes
PANEL_META_PATH=/root/.hermes/model-panel-meta.json
ENV_FILE=/etc/hermes-model-panel.env
# 公网直出时务必 AUTH_DISABLED=0 并设密码
AUTH_DISABLED=1
# ADMIN_PASSWORD=
# SESSION_SECRET=
COOKIE_PATH=/
# 由 HTTPS 反向代理公开时设置规范外部源；Origin 校验和 Secure Cookie 不再猜测客户端头
# PUBLIC_ORIGIN=https://panel.example.com
# COOKIE_SECURE=1
# COOKIE_DOMAIN=
PANEL_UPDATE_REPO=17sho/hermes-model-panel
PANEL_UPDATE_BRANCH=main
PANEL_INSTALL_DIR=/opt/hermes-model-panel
PANEL_SERVICE=hermes-model-panel.service
