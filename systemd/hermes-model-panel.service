[Unit]
Description=Hermes Model Panel
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/hermes-model-panel
EnvironmentFile=/root/hermes-model-panel.env
ExecStart=/usr/bin/node /root/hermes-model-panel/server.js
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
