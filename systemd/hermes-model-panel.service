[Unit]
Description=Hermes Model Panel
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hermes-model-panel
EnvironmentFile=/etc/hermes-model-panel.env
ExecStart=/usr/bin/node /opt/hermes-model-panel/server.js
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
MemoryHigh=384M
MemoryMax=512M
TasksMax=256
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
